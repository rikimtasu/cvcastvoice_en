# --- Game files (copyrighted PS3 assets) — never commit ---
*.cpk
_backup/
# Build output dir (the *.cpk's above are the assets; ignore the whole dir so
# stray build artifacts / previews never get committed either)
out/

# --- Extracted corpus & translation data (this is a CODE-ONLY repo) ---
# Batches and plain-text translation sources
tools/work/batches/
tools/work/tr/
# All translation / build-state JSON produced from game bytes
tools/work/*.json
# Scan / probe / dump text outputs
tools/work/*.txt
# --- Decrypted EBOOT / SELF (copyrighted PS3 game code) — never commit ---
tools/work/EBOOT.elf
tools/work/EBOOT.BIN
tools/work/*.self
tools/work/snaps/

# --- DLC work area (decrypted CPKs, re-encrypted EDATs, backups — game assets) ---
dlc/
tools/work/dlc_batches/
tools/work/overlay_dlc_*.json
tools/work/dlc_audit.txt
tools/work/dlc_segments.txt
# PAC work area (derived segments/batches; tracked only via committed scripts)
tools/work/pac_batches/
tools/work/pac_segments.txt
# Per-batch generators hold the English translation corpus inline
tools/work/gen_tr_b*.py
# Per-batch DLC/PAC generators hold translation corpus inline
tools/work/gen_tr_dlc*.py
tools/work/gen_tr_pac*.py
# Single-file probe/asset dumps
tools/work/*.hex
# Game-derived reference (JP names + readings mined from game bytes)
tools/work/glossary.json
tools/work/glossary.md
# Byte-patch overlays (data, not code)
tools/ov_ctrl.json
tools/ov_en_day101.json

# --- Local build tools (vendored source is tracked; binaries are not) ---
tools/npdata_src/*.exe
tools/npdata_src/*.o

# --- Python bytecode / caches ---
__pycache__/
*.pyc
*.pyo

# --- OS / editor cruft ---
Thumbs.db
.DS_Store
*.swp

